# ============================================================
# Scalping Arise — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
SCALPING_ARISE_APP_NAME=Scalping Arise
SCALPING_ARISE_APP_VERSION=1.0.0
SCALPING_ARISE_ENVIRONMENT=development
SCALPING_ARISE_DEBUG=true

# --- Server ---
SCALPING_ARISE_HOST=0.0.0.0
SCALPING_ARISE_PORT=8000
SCALPING_ARISE_WORKERS=1

# --- API ---
SCALPING_ARISE_API_PREFIX=/api/v1
SCALPING_ARISE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Logging ---
SCALPING_ARISE_LOG_LEVEL=INFO

# --- Market Data Providers ---
# Primary: Twelve Data (free tier: 800 req/day, 8 credits/min)
# Sign up at https://twelvedata.com to get a free API key
SCALPING_ARISE_PRIMARY_PROVIDER=twelve_data
SCALPING_ARISE_FALLBACK_PROVIDER=yfinance
SCALPING_ARISE_TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
SCALPING_ARISE_TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# --- Request Behavior ---
SCALPING_ARISE_REQUEST_TIMEOUT_SECONDS=10.0
SCALPING_ARISE_MAX_RETRIES=2
SCALPING_ARISE_RETRY_DELAY_SECONDS=1.0

# --- Data Freshness (seconds per timeframe) ---
# SCALPING_ARISE_FRESHNESS_TOLERANCE_SECONDS={"1m":120,"5m":600,"15m":1800,"1h":7200,"1d":172800}

# --- Price Consistency ---
SCALPING_ARISE_PRICE_CONSISTENCY_TOLERANCE_PCT=0.5

# --- Volatility Classification ---
# ATR percentage thresholds for volatility classification
# LOW: ATR% <= 0.3%, NORMAL: 0.3% < ATR% < 1.5%, HIGH: 1.5% <= ATR% < 3.0%, EXTREME: ATR% >= 3.0%
SCALPING_ARISE_ATR_LOW_THRESHOLD_PCT=0.3
SCALPING_ARISE_ATR_HIGH_THRESHOLD_PCT=1.5
SCALPING_ARISE_ATR_EXTREME_THRESHOLD_PCT=3.0

# --- Cache ---
SCALPING_ARISE_CACHE_ENABLED=true
SCALPING_ARISE_CACHE_TTL_SECONDS=60
SCALPING_ARISE_CACHE_MAX_CANDLES=10000

# --- Symbol Mapping ---
SCALPING_ARISE_TWELVE_DATA_SYMBOL_XAU_USD=XAU/USD
SCALPING_ARISE_YFINANCE_SYMBOL_XAU_USD=GC=F

# --- Liquidity Analysis ---
# Tolerance (%) for clustering swing highs/lows into equal highs/lows
SCALPING_ARISE_LIQUIDITY_EQUAL_LEVEL_TOLERANCE_PCT=0.05
# Minimum number of swings required to form an equal highs/lows pool
SCALPING_ARISE_LIQUIDITY_MIN_TOUCHES=2
# Sweep detection mode: 'wick' for wick-based, 'close' for close-based
SCALPING_ARISE_LIQUIDITY_SWEEP_MODE=wick
# Minimum distance beyond pool level (%) for a valid sweep (0 = any cross)
SCALPING_ARISE_LIQUIDITY_MIN_SWEEP_DISTANCE_PCT=0.0
# Maximum number of active liquidity pools to retain
SCALPING_ARISE_LIQUIDITY_MAX_ACTIVE_POOLS=20
# Maximum candles to look back for sweep reaction classification
SCALPING_ARISE_LIQUIDITY_MAX_HISTORY_DEPTH=50
